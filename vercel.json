{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/sitemap.js": { "includeFiles": "api/_lib/**" },
    "api/updates.js": { "includeFiles": "api/_lib/**" },
    "api/publish-update.js": { "includeFiles": "api/_lib/**" }
  },
  "crons": [
    {
      "path": "/api/publish-update",
      "schedule": "30 1 * * 2,5"
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
